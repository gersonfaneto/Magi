# modules/apps/term/foot.nix --- foot terminal
{
  self,
  lib,
  config,
  pkgs,
  ...
}:
with lib;
with self.lib; let
  cfg = config.modules.apps.term.foot;
  registry = builtins.fromJSON (builtins.readFile "${self.configDir}/theme/schemes.json");
  keys =
    concatMap
    (name:
      map (tone: "${name}-${tone}") (builtins.filter
        (tone: builtins.pathExists "${self.configDir}/theme/themes/${name}-${tone}.toml")
        ["dark" "light"]))
    (builtins.attrNames registry.schemes);
in {
  options.modules.apps.term.foot = with types; {
    enable = mkBoolOpt false;
  };

  config = mkIf cfg.enable {
    user.packages = with pkgs; [
      foot
      libsixel # image support in foot
    ];

    modules.shell.tmux.term = mkForce "foot";

    # Most remotes don't have foot's terminfo installed and I can't install it
    # on all of them.
    programs.ssh.extraConfig = ''
      Host *
        SetEnv TERM=xterm-256color
    '';

    # foot's colours are rendered from the active palette bundle by
    # theme.py into $XDG_CONFIG_HOME/foot/theme.ini. It is included last so it
    # takes precedence over both the stock and main configs. foot never reloads
    # its includes on its own and our main config is a read-only store symlink,
    # so theme.py pushes new palettes into live windows through
    # `magi @foot reload-colors` (config/foot/bin/reload-colors.zsh).
    home.configFile."foot/foot.ini".text = let
      fonts = config.magi.info.theme.fonts or {};
      terminal = fonts.terminal or {};
    in ''
      # .config/foot/foot.ini
      # Auto-generated by NixOS config
      font=${terminal.name or fonts.mono or "monospace"}:size=${toString (terminal.size or 9)}
      include=${config.home.configDir}/foot/themes/nano-dark.ini
      include=${config.magi.configDir}/foot/foot.ini
      include=${config.home.configDir}/foot/theme.ini
      include=${config.home.configDir}/foot/overrides.ini
    '';

    modules.wm.theme.files.foot = {
      input_path = "${config.magi.configDir}/theme/foot.template.ini";
      output_path = "${config.home.configDir}/foot/theme.ini";
    };

    # The static palette files are generated from config/theme/themes/*.toml
    # for foot.ini's fallback include. The active theme.ini above is rendered
    # at runtime by theme.py. Link each file instead of the directory: Home
    # Manager would have to read a derivation output to walk a recursive
    # source, which pure evaluation forbids.
    home.file = listToAttrs (
      map
      (key: nameValuePair ".config/foot/themes/${key}.ini" {source = "${self.packages.theme-palettes}/foot/${key}.ini";})
      keys
    );
  };
}
