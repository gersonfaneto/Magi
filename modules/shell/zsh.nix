{
  self,
  lib,
  config,
  options,
  pkgs,
  ...
}:
with lib;
with self.lib; let
  cfg = config.modules.shell.zsh;
in {
  options.modules.shell.zsh = with types; {
    enable = mkBoolOpt false;

    rcInit = mkOpt' lines "" ''
      Zsh lines to be written to $XDG_CONFIG_HOME/zsh/extra.zshrc and sourced by
      $XDG_CONFIG_HOME/zsh/.zshrc
    '';
    envInit = mkOpt' lines "" ''
      Zsh lines to be written to ${config.home.configDir}/zsh/extra.zshenv and
      sourced by $XDG_CONFIG_HOME/zsh/.zshenv
    '';

    rcFiles = mkOpt (listOf (either str path)) [];
    envFiles = mkOpt (listOf (either str path)) [];
  };

  config = mkIf cfg.enable {
    programs.zsh = {
      enable = true;
      # I init completion myself, because enableGlobalCompInit initializes it
      # too soon, which means commands initialized later in my config won't get
      # completion, and running compinit twice is slow.
      enableCompletion = true;
      enableGlobalCompInit = false;
      # Again. I configure the prompt myself, so disable the default.
      promptInit = "";
      # Respect XDG please!
      histFile = "$XDG_STATE_HOME/zsh/history";
      # Implement these manually (and with caching)
      enableLsColors = false;
    };

    users.defaultUserShell = pkgs.zsh;

    magi.hookPaths = ["${config.magi.configDir}/zsh/hooks"];

    # Some interactive shell utilies I find universally indispensible.
    user.packages = with pkgs; [
      at
      bat # a better cat
      bc
      dust # a better du
      eza # a better ls
      zoxide # a better (and maintained) fasd
      fd # a better find
      fzf
      gnumake
      libqalculate # calculator cli w/ currency conversion
      nix-zsh-completions
      ripgrep # a better grep
      tokei # for code statistics
      unar
      zip
      unzip
      vim
    ];

    # Ensure XDG compliance
    environment.variables = {
      ZDOTDIR = "$XDG_CONFIG_HOME/zsh";
      ZPM_DIR = "$XDG_DATA_HOME/zpm";
    };

    # Ensure that ZSH's cache directory exists, lest we have IO errors early on.
    systemd.user.tmpfiles.rules = [
      "d %h/.cache/zsh 750 - - - -"
      "d %h/.local/state/zsh 700 - - - -"
    ];

    home.configFile = {
      "zsh/.zshrc".text = ''
        # This file was autogenerated, do not edit it!
        source "${config.magi.configDir}/zsh/.zshrc"

        if [[ $TERM != dumb ]]; then
          # modules.shell.zsh.rcInit
          ${cfg.rcInit}

          # modules.shell.zsh.rcFiles
          ${concatMapStrings (path: "source '${path}'\n  ") cfg.rcFiles}
        fi
      '';

      "zsh/.zshenv".text = ''
        # This file is autogenerated, do not edit it!

        # Be more restrictive with permissions in $HOME; no one has any business
        # reading things that don't belong to them.
        if (( EUID != 0 )); then
          umask 027
        else
          # Be even less permissive if root.
          umask 077
        fi
        source "${config.magi.configDir}/zsh/.zshenv"

        # modules.shell.zsh.envInit
        ${cfg.envInit}

        # modules.shell.zsh.envFiles
        ${concatMapStrings (path: "source '${path}'\n") cfg.envFiles}
      '';

      # bat's base16 theme emits terminal ANSI colours, so it follows whatever
      # palette foot is using without a generated theme or cache rebuild.
      "bat/config".text = "--theme=base16\n";
    };

    modules.wm.theme.files.fzf = {
      input_path = "${config.magi.configDir}/theme/fzf.template.opts";
      output_path = "${config.home.configDir}/fzf/theme.opts";
    };

    # The shell itself: prompt, directory colours, syntax highlighting and
    # autosuggestions all read the same palette bundle as the rest of the
    # desktop. They land in XDG dirs and are sourced by config/zsh/.zshrc (the
    # prompt one last, since prompt.zsh unsets every POWERLEVEL9K_*).
    modules.wm.theme.files = {
      zsh-p10k = {
        input_path = "${config.magi.configDir}/theme/p10k.template.zsh";
        output_path = "${config.home.configDir}/zsh/theme.p10k.zsh";
      };
      zsh-dircolors = {
        input_path = "${config.magi.configDir}/theme/dircolors.template.dircolors";
        output_path = "${config.home.configDir}/zsh/dircolors.theme";
      };
      zsh-syntax-highlighting = {
        input_path = "${config.magi.configDir}/theme/zsh-syntax-highlighting.template.zsh";
        output_path = "${config.home.configDir}/zsh/theme.fsh.zsh";
      };
      zsh-autosuggestions = {
        input_path = "${config.magi.configDir}/theme/zsh-autosuggestions.template.zsh";
        output_path = "${config.home.configDir}/zsh/theme.autosuggest.zsh";
      };
    };
  };
}
