## modules/wm/hyprland/default.nix
#
# Sets up a hyprland-based desktop environment.
{
  self,
  lib,
  config,
  pkgs,
  ...
}:
with lib;
with self.lib; let
  cfg = config.modules.wm.hyprland;
in {
  options.modules.wm.hyprland = with types; {
    extraConfig = mkOpt lines "";
    plugins = mkOpt (listOf package) [];
    monitors =
      mkOpt
      (listOf (submodule {
        options = {
          output = mkOpt str "";
          mode = mkOpt str "preferred";
          position = mkOpt str "auto";
          scale = mkOpt int 1;
          disabled = mkOpt bool false;
          primary = mkOpt bool false;
          vrr = mkOpt int 0;
        };
      })) [{}];
  };

  config = mkIf (config.modules.wm.desktop == "hyprland") (mkMerge [
    ## The compositor.
    (
      let
        flake = self.inputs.hyprland.packages;
      in {
        programs.hyprland = {
          enable = true;
          withUWSM = true;
          systemd.setPath.enable = true;
          package = flake.hyprland;
          portalPackage = flake.xdg-desktop-portal-hyprland;
        };

        modules.wm.hyprland.plugins = [];

        environment.sessionVariables = {
          ELECTRON_OZONE_PLATFORM_HINT = "auto";
          NIXOS_OZONE_WL = "1";
          MOZ_ENABLE_WAYLAND = "1";
        };
      }
    )

    ## Its config: config/hypr/, entered through a generated hyprland.lua.
    (
      let
        primaryMonitor = findFirst (x: x.primary) {} cfg.monitors;
        colorsModule = "hyprland-colors";
      in {
        # The name is all config/hypr/ gets, and "" is truthy in Lua:
        # it would name a monitor that doesn't exist rather than read as absent.
        assertions = [
          {
            assertion = !(primaryMonitor ? output && primaryMonitor.output == "");
            message = "modules.wm.hyprland.monitors: the primary monitor needs an `output`.";
          }
        ];

        magi.info.hypr = {
          primaryMonitor = primaryMonitor.output or null;
          monitors = cfg.monitors;
        };

        home.configFile."hypr/hyprland.lua".text = ''
          -- Auto-generated by nixos. The local tree comes first so hand-written
          -- overrides win without touching the git checkout; the checkout is
          -- the fallback for everything local does not shadow.
          package.path = "${config.home.configDir}/hypr/local/?.lua;"
            .. "${config.home.configDir}/hypr/local/?/init.lua;"
            .. "${config.magi.configDir}/hypr/?.lua;"
            .. package.path

          -- Generated from $XDG_DATA_HOME/magi/info.json
          magi = ${
            generators.toLua {
              multiline = true;
              indent = "  ";
            }
            config.magi.info
          }

          -- Monitor layout lives in the local monitors.lua (the Display
          -- settings surface edits it); magi.hypr.monitors below only names the
          -- primary monitor for the XWayland hint.
          if magi.hypr.primaryMonitor then
            hl.on("hyprland.start", function ()
              -- Wayland has no concept of a primary monitor, so XWayland windows may
              -- start in unpredictable places without this hint.
              hl.exec_cmd("${pkgs.xrandr}/bin/xrandr --output " .. magi.hypr.primaryMonitor .. " --primary")
            end)
          end

          -- Before config/hypr/, which reaches for hl.plugin.*. A plugin can only
          -- be loaded once per session, so this is a restart, not a `magi reload`.
          ${concatMapStringsSep "\n" (p: ''hl.plugin.load("${p}/lib/lib${p.pname}.so")'') cfg.plugins}

          require("hyprland")
          pcall(require, "hyprland-post")

          -- rendered by the theme pipeline (see theme.nix)
          local status, theme = pcall(require, "${colorsModule}")
          if status then
            magi.theme = theme
            theme.apply()
          end
        '';

        home.configFile."hypr/hyprland-post.lua" = mkIf (cfg.extraConfig != "") {
          text = cfg.extraConfig;
        };

        modules.wm.theme.files.hyprland = {
          input_path = "${config.magi.configDir}/hypr/hyprland-colors.template.lua";
          output_path = "${config.home.configDir}/hypr/${colorsModule}.lua";
          post_hook = ''hyprctl eval 'package.loaded["${colorsModule}"] = nil; magi.theme = require("${colorsModule}"); magi.theme.apply()' 2>/dev/null || true'';
        };

        modules.shell.zsh.rcFiles = ["${config.magi.configDir}/hypr/aliases.zsh"];
      }
    )

    ## So lua-language-server completion and linting is aware of hyprland's API,
    ## and of the magi table this module splices in beside it. Both are gitignored
    ## by .gitignore's *.meta.lua.
    (
      let
        # Describe the `magi` table for `lua-language-server` dynamically, so the two
        # can't drift. Nested classes must come first.
        luaMeta = name: attrs: bind: let
          typeOf = path: v:
            if v == null
            then "any" # says a field exists, not what it holds
            else if isBool v
            then "boolean"
            else if isInt v
            then "integer"
            else if isString v
            then "string"
            else if isAttrs v
            then path
            else if isList v
            then
              (
                if v == []
                then "any[]"
                else "${typeOf path (head v)}[]"
              )
            else "number";
          # A list documents its element type, so both spell the same class
          # name -- and typeOf recurses through nesting, so this has to too, or
          # a list of lists of attrs names a class nothing defines.
          elemOf = v:
            if isList v && v != []
            then elemOf (head v)
            else v;
          nested =
            concatMap
            (
              n: let
                path = "${name}.${n}";
              in
                optionals (isAttrs (elemOf attrs.${n})) (
                  luaMeta path (elemOf attrs.${n}) "local ${replaceStrings ["."] ["_"] "__${path}"}"
                )
            )
            (attrNames attrs);
        in
          nested
          ++ [
            ''
              ---@class ${name}
              ${concatMapStringsSep "\n" (n: "---@field ${n} ${typeOf "${name}.${n}" attrs.${n}}") (
                attrNames attrs
              )}
              ${bind} = {}
            ''
          ];

        magiMeta = pkgs.writeText "magi.meta.lua" ''
          -- Auto-generated by nixos, from magi.info. Describes the `magi` table that
          -- modules/wm/hyprland/default.nix splices into hyprland.lua.
          ---@meta

          ${concatStringsSep "\n" (luaMeta "magi" config.magi.info "magi")}
        '';
      in {
        system.userActivationScripts.magi-hyprland-lua-stub = ''
          ln -sfn ${config.programs.hyprland.package}/share/hypr/stubs/hl.meta.lua \
                  ${config.magi.configDir}/hypr/lib/hl.meta.lua
          ln -sfn ${magiMeta} ${config.magi.configDir}/hypr/lib/magi.meta.lua
        '';
      }
    )

    ## For CLIs
    {
      environment.systemPackages = with pkgs; [
        wlr-randr # for monitors that hyprctl can't handle
        wf-recorder # for screencasting
        slurp # slop
        grim # screenshot
        fsel # launcher and the `magi @menu` backend
        foot # terminal host for fsel and the TUI pickers
        cliphist # clipboard history
        hyprlock # the session lock, from lock.sh and hypridle
        hypridle # idle timeouts
        hyprsunset # night light
        playerctl # media keys
        brightnessctl # backlight keys
        awww # wallpaper daemon
        python3 # wallcolors.py and theme.py
        mpvpaper # video wallpapers
        ffmpeg-headless # wallpaper stills and thumbnails; no X11/GL needed
        imagemagick # wallpaper analysis and thumbnails
        adw-gtk3 # base theme for the GTK app palette
        # OCR reads the languages that are actually used instead of dragging in
        # tessdata-all (1 GiB). Add here when OCR needs another language.
        (tesseract.override {enableLanguages = ["eng" "por" "osd"];})
        ripdrag # Replaces xdragon
        wev # Replaces xev
        wl-clipboard # Replaces xclip
        wtype # Replaces xdotool (sorta)
        swayimg # Replaces feh (as an image previewer)
        imv
        libnotify # notify-send
        xdg-utils
        sox # for `play` utility
        hyprpicker # replaces `dms color pick`
      ];

      # To give Rofi targets
      user.packages =
        map
        (
          fmt:
            mkLauncherEntry "Color picker: grab ${fmt} at point" {
              icon = "com.github.finefindus.eyedropper";
              exec = "hyprpicker -a -f ${toLower fmt}";
            }
        )
        [
          "RGB"
          "HSL"
          "hex"
        ];

      home.configLink."swayimg" = "${config.magi.configDir}/swayimg";
    }

    ## The session plumbing the old shell module used to own: config links,
    ## daemons, and the theme/wallpaper pipeline.
    (
      let
        # hypridle/hyprsunset read their config from ~/.config/hypr. Seed the
        # initial copy from the checkout when missing so the daemons can start
        # before anything has written one.
        seedConf = name:
          pkgs.writeShellScript "magi-seed-${name}" ''
            cfg="$HOME/.config/hypr/${name}"
            if [ ! -e "$cfg" ]; then
              mkdir -p "$(dirname "$cfg")"
              cp "${config.magi.configDir}/hypr/${name}" "$cfg"
            fi
          '';
        notifyd = pkgs.python3.withPackages (ps: [ps.dbus-next]);
      in {
        # Linked from the live checkout, so script edits need no rebuild.
        home = {
          configLink."hypr/scripts" = "${config.magi.configDir}/hypr/scripts";
          dataLink."magi/wallpapers" = "${config.magi.configDir}/assets/wallpapers";
        };

        # hyprlock has no runtime reload of its own, so it is rendered like
        # every other palette consumer instead of being a config link.
        modules.wm.theme.files.hyprlock = {
          input_path = "${config.magi.configDir}/theme/hyprlock.template.conf";
          output_path = "${config.home.configDir}/hypr/hyprlock.conf";
        };

        systemd.user.services = {
          # The clipboard history behind SUPER+V.
          cliphist = {
            description = "Clipboard history store";
            wantedBy = ["graphical-session.target"];
            partOf = ["graphical-session.target"];
            after = [
              "graphical-session.target"
              "wayland-wm@hyprland.desktop.service"
            ];
            serviceConfig = {
              # The script skips CLIPBOARD_STATE=sensitive, so passwords copied
              # with `wl-copy --sensitive` never reach the database. It starts
              # its two watchers in the background and exits.
              Type = "oneshot";
              RemainAfterExit = true;
              ExecStart = "${config.magi.configDir}/hypr/scripts/cliphist-watch.sh";
            };
          };

          # The notification bus, answered with a log instead of a pop-up.
          magi-notifyd = {
            description = "magi notification log";
            wantedBy = ["graphical-session.target"];
            partOf = ["graphical-session.target"];
            after = ["graphical-session.target"];
            serviceConfig = {
              ExecStart = "${notifyd}/bin/python3 ${config.magi.configDir}/bin/magi-notifyd";
              Restart = "on-failure";
            };
          };

          hypridle = {
            description = "Hypridle idle daemon";
            wantedBy = ["graphical-session.target"];
            partOf = ["graphical-session.target"];
            after = ["graphical-session.target"];
            # hyprlock wants the session's fonts and cursor from PATH.
            enableDefaultPath = false;
            serviceConfig = {
              ExecStartPre = "${seedConf "hypridle.conf"}";
              ExecStart = "${getExe' pkgs.hypridle "hypridle"}";
              Restart = "on-failure";
            };
          };

          hyprsunset = {
            description = "Hyprsunset night light";
            wantedBy = ["graphical-session.target"];
            partOf = ["graphical-session.target"];
            after = ["graphical-session.target"];
            enableDefaultPath = false;
            serviceConfig = {
              ExecStartPre = "${seedConf "hyprsunset.conf"}";
              ExecStart = "${getExe' pkgs.hyprsunset "hyprsunset"}";
              Restart = "on-failure";
            };
          };

          # Bring the last wallpaper back once Hyprland is up. wallpaper.sh
          # starts awww itself, and mpvpaper for video wallpapers, so there is
          # no separate wallpaper daemon unit to keep alive.
          magi-wallpaper = {
            description = "Restore the last wallpaper";
            wantedBy = ["graphical-session.target"];
            partOf = ["graphical-session.target"];
            after = [
              "graphical-session.target"
              "wayland-wm@hyprland.desktop.service"
            ];
            # wallpaper.sh drives awww, mpvpaper, jq, hyprctl and python3.
            enableDefaultPath = false;
            serviceConfig = {
              Type = "oneshot";
              ExecStart = "${config.magi.configDir}/hypr/scripts/wallpaper.sh init";
              RemainAfterExit = true;
            };
          };

          # The palette-driven templates. Nix owns the two mono palettes
          # (palette.nix); theme.py copies the active one to current.json and
          # renders the manifest that theme.nix generates. The path unit
          # re-renders when `magi theme` changes the tone or the manifest does.
          magi-theme = {
            description = "Apply the active palette and render its templates";
            wantedBy = ["graphical-session.target"];
            partOf = ["graphical-session.target"];
            after = ["graphical-session.target"];
            # The post-hooks and wallcolors.py run hyprctl/gsettings.
            enableDefaultPath = false;
            serviceConfig = {
              Type = "oneshot";
              ExecStart = "${pkgs.python3}/bin/python3 ${config.magi.configDir}/hypr/scripts/theme.py apply";
            };
          };
        };

        systemd.user.paths.magi-theme = {
          wantedBy = ["graphical-session.target"];
          partOf = ["graphical-session.target"];
          pathConfig = {
            PathChanged = [
              "%h/.local/state/magi/theme/flags.json"
              "%h/.local/state/magi/theme/templates.json"
            ];
            Unit = "magi-theme.service";
          };
        };
      }
    )

    ## The session's edges.
    {
      # The Settings surfaces write to ~/.config/hypr/local/modules, so the
      # local tree has to exist before they first open. Existing files are
      # never overwritten; `magi @hypr reset-settings` is the destructive reset.
      systemd.user.services.hypr-settings-seed = {
        description = "Seed the local Hyprland settings tree";
        wantedBy = ["graphical-session.target"];
        partOf = ["graphical-session.target"];
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          ExecStart = "${config.magi.configDir}/hypr/scripts/seed-local-config.sh";
        };
      };

      # The session only ever powers off from an explicit action, so this is
      # what fades the screen before the session dies -- along with an ssh
      # `reboot` or a critical battery. Stopping last means the compositor is
      # still up to serve the fade, and on-shutting-down.zsh's stamp keeps the
      # second call quiet when an eager caller got there first.
      systemd.user.services.magi-shutdown-hook = {
        description = "Run magi's shutdown hooks before the session dies";
        wantedBy = ["graphical-session.target"];
        partOf = ["graphical-session.target"];
        restartIfChanged = false; # don't trigger on `magi sync`
        after = [
          "graphical-session.target"
          "wayland-wm@hyprland.desktop.service" # the compositor, for the fade
        ];
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          ExecStart = "${getExe' pkgs.coreutils "true"}";
          # -f because the stamp is the guard now; hook.janet's would only make
          # a no-op exit 127 and log a unit failure on the way down.
          ExecStop = "${config.magi.bin} hook -f on-shutting-down";
          # A wedged hook must not hold the shutdown open indefinitely.
          TimeoutStopSec = 15;
        };
      };

      # There are no compositor suspend/resume events, so these ride systemd's
      # sleep target instead. They run as root; --machine=USER@.host --user is
      # how root reaches into the user's session without sudo, and `|| true` is
      # so a failing hook can't fail the unit.
      #
      # Not powerManagement.{powerDown,resume}Commands, which would be the
      # obvious home: nixpkgs pastes powerDownCommands into post-boot's preStop
      # as well as sleep-actions', so everything put there also fires on every
      # poweroff.
      systemd.services.magi-sleep-hook = let
        run = hook: ''
          ${pkgs.systemd}/bin/systemd-run --machine=${config.user.name}@.host \
            --user --pipe --wait --collect --quiet \
            ${config.magi.bin} hook -f ${hook} || true
        '';
      in {
        description = "Run magi's sleep hooks around suspend";
        wantedBy = ["sleep.target"];
        before = ["sleep.target"];
        # So resuming stops the unit, and stopping it is what runs on-wakeup.
        unitConfig.StopWhenUnneeded = true;
        script = run "on-suspend";
        preStop = run "on-wakeup";
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          # systemd-run --wait blocks; a wedged hook must not hold the lid.
          TimeoutStartSec = 15;
          TimeoutStopSec = 15;
        };
      };
    }
  ]);
}
