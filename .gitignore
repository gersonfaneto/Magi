/build/
/result
*.zwc
*.janet.tested

# Built on demand by config/claude/scripts/ensure-reference-*.zsh
/config/claude/data/refs/*
!/config/claude/data/refs/README.md
/config/claude/data/repo/

# Symlinked in by nixos modules
*.meta.lua

# Rendered by Noctalia (modules/wm/theme.nix)
/config/zellij/themes/colors.kdl
/config/yazi/theme.toml
/config/yazi/flavors/
# modules/apps/rofi.nix
/config/rofi/themes/fonts.rasi
/config/rofi/themes/colors.rasi

# Local plugin install artifacts (npm), not part of the dotfiles tree.
/config/opencode/node_modules

# Hosts are a whitelist: only melchior is tracked. Scaffold new ones with
# `nix run .#install` (see hosts/README.md) and commit them when they're
# worth keeping.
/hosts/*
!/hosts/melchior/
!/hosts/README.md
