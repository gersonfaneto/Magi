#!/usr/bin/env zsh
# vim:ft=zsh:et:ts=2:sw=2:sts=2:
#
# Switch the whole session between the light and dark mono themes.
#
# SYNOPSIS:
#   setbg [light|dark] [--next]
#
# DESCRIPTION:
#   Picks the light or dark variant of the single mono palette and re-renders
#   every consumer through theme.py: Hyprland, Qt, GTK, fsel, qutebrowser,
#   foot, highlight, nvim, tmux, fzf and the zsh shell. It also switches to a
#   wallpaper from the matching built-in pair. With no argument, prints the
#   active variant; --next flips it.
#
# ARGUMENTS:
#   * BG @arg-bg  'light' or 'dark'.

main() {
  local bg='' next=false arg
  for arg in "$@"; do
    case "$arg" in
      -h | --help)
        print "Usage: ${0:t} [light|dark|--next]"
        exit
        ;;
      --next)
        next=true
        ;;
      light | dark)
        bg="$arg"
        ;;
      *)
        print -u2 "Usage: ${0:t} [light|dark|--next]"
        return 1
        ;;
    esac
  done

  if ! command -v magi >/dev/null 2>&1; then
    print -u2 "Error: 'magi' not found"
    return 1
  fi

  if $next; then
    [[ $(magi theme status | awk '/^bg:/ { print $2 }') == light ]] && bg=dark || bg=light
  fi

  magi theme bg ${bg:+"$bg"}
}

main "$@"
