#!/usr/bin/env zsh
# vim:ft=zsh:et:ts=2:sw=2:sts=2:
# Get current location in the format of 'latitude longitude'

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CACHE_FILE="$STATE_HOME/location"
LOC_URL=http://ipinfo.io/loc

local script_name=${0:t}

usage() {
  cat <<EOF
Usage: $script_name [OPTIONS]

Get current location in the format of 'latitude longitude'

Options:
  -h, --help      Show this help message and exit
      --no-cache  Don't use cached location, else will read from cache file
                  $CACHE_FILE if no internet connection
EOF
}

get_coords_from_internet() {
  local coords
  if command -v curl >/dev/null 2>&1; then
    coords=$(curl -s "$LOC_URL")
  elif command -v wget >/dev/null 2>&1; then
    coords=$(wget -qO- "$LOC_URL")
  else
    # shellcheck disable=SC2016
    print -u2 '`curl` or `wget` not found, cannot get location'
    return 1
  fi

  if [[ -z $coords ]] || ! (print -r -- "$coords" | grep -Eq '^([+-]?[0-9]+\.[0-9]+,?){2}$'); then
    print -u2 "Failed to get location from $LOC_URL: $coords"
    return 1
  fi

  print -r -- "$coords"
}

get_coords_from_cache() {
  if [[ ! -r $CACHE_FILE ]]; then
    return 1
  fi
  cat "$CACHE_FILE"
}

save_coords_to_cache() {
  print -r -- "$1" >"$CACHE_FILE"
}

# Convert latitude and longitude format from [+-]0.0000 to
# 0.0000[NS] (latitude) or 0.0000[EW] (longitude)
format_coords() {
  local coords=$1
  local latitude longitude
  if [[ -z $coords ]] || ! (print -r -- "$coords" | grep -Eq '^([+-]?[0-9]+\.[0-9]+,?){2}$'); then
    print -u2 "Cannot parse coords $coords: unexpected format"
    return 1
  fi

  latitude=${coords%,*}
  longitude=${coords#*,}

  case "$latitude" in
    -*) latitude="${latitude#-}S" ;;
    *) latitude="${latitude}N" ;;
  esac

  case "$longitude" in
    -*) longitude="${longitude#-}W" ;;
    *) longitude="${longitude}E" ;;
  esac

  print -r -- "$latitude" "$longitude"
}

main() {
  local use_cache=1
  while (( $# )); do
    case "$1" in
      -h | --help)
        usage
        exit
        ;;
      --no-cache)
        use_cache=0
        shift
        ;;
      *)
        print -u2 "Unkown argument: $1"
        usage
        exit 1
        ;;
    esac
  done

  local coords
  coords=$(get_coords_from_internet)
  if [[ -n $coords ]]; then
    save_coords_to_cache "$coords"
  elif (( use_cache )); then
    coords=$(get_coords_from_cache)
  fi

  format_coords "$coords"
}

main "$@"
