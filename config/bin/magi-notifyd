#!/usr/bin/env python3
"""A notification sink that logs instead of drawing.

Owns org.freedesktop.Notifications so notify-send and apps get an answer, and
appends one JSON object per notification to
$XDG_STATE_HOME/magi/notifications.jsonl. Nothing pops up; read the log with
`magi notify`.

Run by systemd as magi-notifyd.service (modules/wm/hyprland).
"""
import asyncio
import json
import os
import signal
import time
from pathlib import Path

from dbus_next.aio import MessageBus
from dbus_next.service import ServiceInterface, method


def log_path():
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state")
    return state / "magi" / "notifications.jsonl"


def plain(value):
    """Unwrap dbus-next Variants and bytes so the log stays JSON."""
    if hasattr(value, "value"):
        return plain(value.value)
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    if isinstance(value, (list, tuple)):
        return [plain(v) for v in value]
    if isinstance(value, dict):
        return {str(k): plain(v) for k, v in value.items()}
    return value


class Notifications(ServiceInterface):
    def __init__(self):
        super().__init__("org.freedesktop.Notifications")
        self.next_id = 1

    @method()
    def GetCapabilities(self) -> "as":
        return ["body", "body-markup", "icon-static", "persistence"]

    @method()
    def GetServerInformation(self) -> "ssss":
        return ["magi-notifyd", "magi", "1.0", "1.2"]

    @method()
    def CloseNotification(self, replaced: "u"):
        return None

    @method()
    def Notify(
        self,
        app_name: "s",
        replaces_id: "u",
        app_icon: "s",
        summary: "s",
        body: "s",
        actions: "as",
        hints: "a{sv}",
        expire_timeout: "i",
    ) -> "u":
        entry_id = replaces_id or self.next_id
        self.next_id = max(self.next_id + 1, entry_id + 1)
        hints = plain(hints)
        entry = {
            "id": entry_id,
            "time": int(time.time()),
            "app": app_name,
            "summary": summary,
            "body": body,
            "icon": app_icon,
            "urgency": hints.get("urgency", 1),
            "actions": plain(actions),
            "hints": hints,
        }
        path = log_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as fh:
            fh.write(json.dumps(entry) + "\n")
        return entry_id


async def main():
    bus = await MessageBus().connect()
    bus.export("/org/freedesktop/Notifications", Notifications())
    await bus.request_name("org.freedesktop.Notifications")
    loop = asyncio.get_running_loop()
    stop = loop.create_future()
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, lambda: stop.done() or stop.set_result(None))
    await stop
    bus.disconnect()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
