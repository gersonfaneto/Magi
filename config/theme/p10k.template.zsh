# Auto-generated by the theme pipeline (config/hypr/scripts/theme.py).
# Edit config/theme/p10k.template.zsh, not this file.
#
# Sourced after config/zsh/prompt.zsh, which unsets every POWERLEVEL9K_*
# parameter at the top of its config function -- so this file has to run last.
# Powerlevel10k takes #RRGGBB values, so these follow the palette exactly
# instead of pinning the wizard's 2021 xterm-256 indices.

