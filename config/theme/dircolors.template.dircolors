# Auto-generated by the theme pipeline (config/hypr/scripts/theme.py).
# Edit config/theme/dircolors.template.dircolors, not this file.
#
# A dircolors database (see `info dircolors`). No TERM sections, so it applies
# to every terminal; the colours are truecolor, which foot renders directly.

RESET 0

DIR {{colors.primary.ansi38}}
LINK {{terminal.ansi6.ansi38}}
MULTIHARDLINK {{colors.on_surface.ansi38}}
FIFO {{colors.tertiary.ansi38}}
SOCK {{colors.tertiary.ansi38}}
DOOR {{colors.tertiary.ansi38}}
BLK {{colors.error.ansi38}}
CHR {{colors.error.ansi38}}
ORPHAN {{colors.error.ansi38}}
MISSING {{colors.error.ansi38}}
EXEC {{terminal.ansi2.ansi38}}
SETUID {{colors.error.ansi38}}
SETGID {{colors.error.ansi38}}
STICKY_OTHER_WRITABLE {{colors.primary.ansi48}};{{colors.on_primary.ansi38}}
OTHER_WRITABLE {{colors.tertiary.ansi48}};{{colors.on_tertiary.ansi38}}
STICKY {{colors.primary.ansi48}};{{colors.on_primary.ansi38}}
CAPABILITY {{colors.error.ansi38}}

