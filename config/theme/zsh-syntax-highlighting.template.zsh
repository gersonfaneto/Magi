# Auto-generated by the theme pipeline (config/hypr/scripts/theme.py).
# Edit config/theme/zsh-syntax-highlighting.template.zsh, not this file.
#
# fast-syntax-highlighting styles. Sourced after the plugin has declared
# FAST_HIGHLIGHT_STYLES, and zsh 5.9 passes #RRGGBB straight to the terminal,
# so the command line follows the same palette as everything else.

FAST_HIGHLIGHT_STYLES[default]='none'
FAST_HIGHLIGHT_STYLES[unknown-token]='fg={{colors.error.hex}},bold'
FAST_HIGHLIGHT_STYLES[reserved-word]='fg={{colors.tertiary.hex}}'
FAST_HIGHLIGHT_STYLES[subcommand]='fg={{colors.tertiary.hex}}'
FAST_HIGHLIGHT_STYLES[alias]='fg={{colors.secondary.hex}}'
FAST_HIGHLIGHT_STYLES[suffix-alias]='fg={{colors.secondary.hex}}'
FAST_HIGHLIGHT_STYLES[global-alias]='bg={{colors.primary_container.hex}},fg={{colors.on_primary_container.hex}}'
FAST_HIGHLIGHT_STYLES[builtin]='fg={{colors.primary.hex}}'
FAST_HIGHLIGHT_STYLES[function]='fg={{colors.primary.hex}}'
FAST_HIGHLIGHT_STYLES[command]='fg={{colors.primary.hex}}'
FAST_HIGHLIGHT_STYLES[precommand]='fg={{colors.primary.hex}}'
FAST_HIGHLIGHT_STYLES[commandseparator]='fg={{colors.outline.hex}}'
FAST_HIGHLIGHT_STYLES[hashed-command]='fg={{colors.primary.hex}}'
FAST_HIGHLIGHT_STYLES[path]='fg={{colors.on_surface.hex}}'
FAST_HIGHLIGHT_STYLES[path-to-dir]='fg={{colors.primary.hex}},underline'
FAST_HIGHLIGHT_STYLES[path_pathseparator]=''
FAST_HIGHLIGHT_STYLES[globbing]='fg={{terminal.ansi4.hex}},bold'
FAST_HIGHLIGHT_STYLES[globbing-ext]='fg={{terminal.ansi4.hex}}'
FAST_HIGHLIGHT_STYLES[history-expansion]='fg={{terminal.ansi4.hex}},bold'
FAST_HIGHLIGHT_STYLES[single-hyphen-option]='fg={{terminal.ansi3.hex}}'
FAST_HIGHLIGHT_STYLES[double-hyphen-option]='fg={{terminal.ansi3.hex}}'
FAST_HIGHLIGHT_STYLES[back-quoted-argument]='none'
FAST_HIGHLIGHT_STYLES[single-quoted-argument]='fg={{terminal.ansi2.hex}}'
FAST_HIGHLIGHT_STYLES[double-quoted-argument]='fg={{terminal.ansi2.hex}}'
FAST_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg={{terminal.ansi2.hex}}'
FAST_HIGHLIGHT_STYLES[back-or-dollar-double-quoted-argument]='fg={{terminal.ansi6.hex}}'
FAST_HIGHLIGHT_STYLES[back-dollar-quoted-argument]='fg={{terminal.ansi6.hex}}'
FAST_HIGHLIGHT_STYLES[assign]='none'
FAST_HIGHLIGHT_STYLES[redirection]='none'
FAST_HIGHLIGHT_STYLES[comment]='fg={{colors.on_surface_variant.hex}}'
FAST_HIGHLIGHT_STYLES[variable]='fg={{terminal.ansi5.hex}}'
FAST_HIGHLIGHT_STYLES[mathvar]='fg={{terminal.ansi4.hex}},bold'
FAST_HIGHLIGHT_STYLES[mathnum]='fg={{terminal.ansi5.hex}}'
FAST_HIGHLIGHT_STYLES[matherr]='fg={{terminal.ansi1.hex}}'
FAST_HIGHLIGHT_STYLES[assign-array-bracket]='fg={{terminal.ansi2.hex}}'
FAST_HIGHLIGHT_STYLES[for-loop-variable]='none'
FAST_HIGHLIGHT_STYLES[for-loop-operator]='fg={{terminal.ansi3.hex}}'
FAST_HIGHLIGHT_STYLES[for-loop-number]='fg={{terminal.ansi5.hex}}'
FAST_HIGHLIGHT_STYLES[for-loop-separator]='fg={{terminal.ansi3.hex}},bold'
FAST_HIGHLIGHT_STYLES[here-string-tri]='fg={{terminal.ansi3.hex}}'
FAST_HIGHLIGHT_STYLES[here-string-text]='bg={{colors.surface_container.hex}}'
