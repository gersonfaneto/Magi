#!/usr/bin/env zsh
# magi.log [-c COLOR] [-1|-2|-3] [--] [MESSAGE...]
#
# Prints MESSAGE to stderr when $MAGIDEBUG is at or above the given level (1).
# Reads stdin if MESSAGE is omitted.

[[ -z ${MAGIDEBUG:-} ]] && return

local color=blue
while true; do
  case ${1-} in
    -c) color=$2; shift 2 ;;
    -[123]) (( ${1#-} > MAGIDEBUG )) && return; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

# Global, or SECONDS is local to this function and every timestamp reads ~0.
typeset -gF SECONDS
magi.echo -c $color \
  -p "$(printf '%.4f' $SECONDS):${ZSH_ARGZERO:t:r}[$$]: " \
  -- "${@:-$(cat)}" >&2
