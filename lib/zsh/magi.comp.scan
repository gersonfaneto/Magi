#!/usr/bin/env zsh
# magi.comp.scan DIR...
#
# Leaves "name:description" pairs for the scripts in DIR... in $_magi_reply.
# See lib/zsh/completions/_magi for what reads it.

local bin=${_magi_bin:-magi}
(( $# )) || return 1
(( $+commands[$bin] )) || return 1
_magi_reply=( ${(f)"$(command $bin help --scan "$@" 2>/dev/null)"} )
(( $#_magi_reply ))
