#!/usr/bin/env zsh
# magi.comp.commands
#
# $_magi_bin's subcommand menu. `help --dump` with no arguments emits ready-made
# _describe pairs in three groups: commands, aliases, then the sigil patterns.
# It always emits all three, and the first holds every command, so neither can
# be empty in practice; the (@) is still load-bearing, to keep an empty group
# from shifting later ones.
#
# A front-end that also dispatches into script directories hands me
# $_magi_bindirs and $_magi_cfgdirs, and the menu grows the sigils that reach them.

local -a cmds aliases groups scripts dirs _magi_reply
local expl bin=${_magi_bin:-magi}

if (( $#_magi_bindirs )); then
  # Use ./path and /path verbatim
  [[ $PREFIX == (|.)/* ]] && { _files; return }

  # @FOO dispatches to config/FOO/bin
  if compset -P '@'; then
    (( $#_magi_cfgdirs )) || return 1
    _wanted directories expl 'config directory' compadd -a _magi_cfgdirs
    return
  fi

  # .FOO searches the host, wm, then top-level bin directories
  if compset -P '.'; then
    magi.comp.scripts $_magi_bindirs
    return
  fi
fi

(( $+commands[$bin] )) || return 1
groups=( "${(@ps:\n\n:)"$(command $bin help --dump 2>/dev/null)"}" )
(( $#groups >= 2 )) || return 1
cmds=( ${(f)groups[1]} )
aliases=( ${(f)groups[2]} )
_describe -t commands "$bin command" cmds -- aliases

# Offer the dynamic namespaces too, so a bare `magi TAB` is a full menu. The
# sigils are part of the match so they don't shadow real subcommands.
(( $#_magi_bindirs )) || return
if magi.comp.scan $_magi_bindirs; then
  scripts=( ${_magi_reply/#/.} )
  _describe -t scripts 'script' scripts
fi
dirs=( ${_magi_cfgdirs/#/@} )
(( $#dirs )) &&
  _wanted directories expl 'config directory' compadd -a dirs
