# treefmt.nix --- formatter config for `nix fmt` (see https://github.com/numtide/treefmt-nix)
#
# `nix fmt` formats the tree; the `formatting` flake check fails when anything
# is unformatted, so `nix flake check` enforces it in CI.
{pkgs, ...}: {
  projectRootFile = "flake.nix";

  # Nix (nixfmt is also what modules/editors/vim.nix installs)
  programs.alejandra.enable = true;

  # Lua, mirroring config/nvim/.stylua.toml
  programs.stylua.enable = true;
  programs.stylua.settings = {
    column_width = 79;
    indent_type = "Spaces";
    indent_width = 2;
    quote_style = "AutoPreferSingle";
  };

  # Shell: shfmt formats *.sh/*.bash. shellcheck is deliberately NOT gated:
  # it reports pre-existing findings in 8 scripts (SC2068 on POSIX $@,
  # SC2034 in vendored ranger/scope.sh, SC2145) that need their own change.
  # shellcheck stays available via modules/editors/vim.nix.
  programs.shfmt.enable = true;

  # Markup and data
  programs.taplo.enable = true;
  programs.yamlfmt.enable = true;
  programs.jsonfmt.enable = true;
  programs.mdformat.enable = true;
  # Keep consecutive list numbering (1. 2. 3.) instead of mdformat's
  # default of rewriting every item to 1.
  programs.mdformat.settings.number = true;
  # Prettier covers only css/js/ts. NOTE: settings.formatter.*.includes
  # CONCATENATES with the module defaults (it cannot narrow), so narrow via
  # excludes, which take precedence. Without this prettier also claims
  # *.md/*.json/*.yaml and mangles prose (it eats glob stars: *.zsh -> _.zsh).
  programs.prettier.enable = true;
  settings.formatter.prettier.excludes = [
    "*.cjs"
    "*.html"
    "*.json"
    "*.json5"
    "*.jsx"
    "*.md"
    "*.mdx"
    "*.mjs"
    "*.scss"
    "*.tsx"
    "*.vue"
    "*.yaml"
    "*.yml"
  ];

  # StyLua only parses these with an explicit syntax: the default chokes on
  # the nvim tree's `goto`/labels, and the module's settings schema has no
  # `syntax` key, so pass it as a CLI flag (matches .stylua.toml).
  settings.formatter.stylua.options = [
    "--syntax"
    "LuaJIT"
  ];

  settings.global.excludes = [
    "*.janet" # no treefmt formatter exists for janet
    "*.luau" # vendored noctalia plugin sources; stylua targets *.lua
    "*.rasi" # rofi themes have no formatter
    "*.template.lua" # matugen/nix templates with {{ }} placeholders
    "config/nvim/nvim-pack-lock.json" # generated by vim.pack
    "config/yazi/yazi.toml" # multiline inline tables: yazi accepts, taplo rejects
    # Generated files (see AGENTS.md gotchas)
    "config/claude/data/refs/*"
    "*.meta.lua"
    "config/zellij/themes/colors.kdl"
    "config/yazi/theme.toml"
    "config/rofi/themes/colors.rasi"
    "config/rofi/themes/fonts.rasi"
  ];
}
