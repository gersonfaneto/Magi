#!/usr/bin/env zsh
# Stand-in for systemctl, for test/magi/sync.janet.
#
# Logs its arguments; `start` exits $MAGI_TEST_UNIT_EXIT, so the suite can tell
# a unit that failed from one that ran; `show` answers with a fixed
# InvocationID, so the suite can check journalctl was asked for that run.
print -r -- "systemctl $*" >>$MAGI_TEST_SYNC_LOG
case $1 in
  (start) exit ${MAGI_TEST_UNIT_EXIT:-0} ;;
  (show) print 0123456789abcdef0123456789abcdef ;;
esac
