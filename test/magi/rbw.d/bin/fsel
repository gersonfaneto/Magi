#!/bin/sh
# Stub fsel for test/magi/rbw.janet. Reads the TSV menu rows on stdin and
# returns the row id (third column) the test asked for; prompt mode returns the
# next queued input instead.
pick=${RBW_TEST_PICK:-first}

case " $* " in
  *" --prompt-only "*)
    n=$(cat "$RBW_TEST_COUNTER" 2>/dev/null || printf '0')
    n=$((n + 1))
    printf '%s' "$n" >"$RBW_TEST_COUNTER"
    cat "$RBW_TEST_INPUT_DIR/$n" 2>/dev/null
    exit 0
    ;;
esac

awk -F'\t' -v pick="$pick" '
  BEGIN {
    want = pick
    sub(/^action:/, "", want)
    gsub(/-/, " ", want)
    wantN = tolower(want)
    gsub(/ /, "", wantN)
    # Rows the old picker never returned for "last": it selected the last
    # string-valued row, and these entries carry action tables instead.
    excluded = "Open website|Edit password|Edit notes|Delete entry|New entry|Sync vault|Unlock vault"
  }
  {
    if (first == "") first = $3
    if ($1 !~ "^(" excluded ")$") last = $3
    if (pick ~ /^action:/) {
      label = tolower($1)
      gsub(/ /, "", label)
      if (label == wantN || index(label, wantN) == 1) found = $3
    }
  }
  END {
    if (pick == "last") print last
    else if (pick ~ /^action:/ && found != "") print found
    else print first
  }
'
