#!/usr/bin/env zsh
# Stand-in for $EDITOR, for test/magi/ops-edit.janet. Appends $MAGI_OPS_TEST_EDIT
# to every file it's handed, or touches nothing if that's empty, then exits
# $MAGI_OPS_TEST_EDITOR_EXIT -- the :cq an editor uses to say "forget it".
local f
for f in "$@"; do
  [[ -n $MAGI_OPS_TEST_EDIT ]] && print -r -- "$MAGI_OPS_TEST_EDIT" >>$f
done
exit ${MAGI_OPS_TEST_EDITOR_EXIT:-0}
