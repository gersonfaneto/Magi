#!/usr/bin/env zsh
# Stand-in for systemctl --user, for test/magi/idle.janet. Logs its argv and
# keeps one marker file per unit, so is-active, start, stop and list-timers
# agree across invocations the way systemd would.
print -r -- "systemctl $*" >>${MAGI_TEST_LOG:?}
state=${MAGI_TEST_IDLE_STATE:?}
[[ $1 == --user ]] && shift
cmd=$1
case $cmd in
  is-active)
    unit=$2
    [[ $unit == --* ]] && unit=$3
    [[ -n $unit && -e $state/$unit ]]
    exit $? ;;
  start) touch $state/$2 ;;
  stop)  rm -f $state/$2 ;;
  list-timers)
    unit=$2
    if [[ -e $state/$unit ]]; then
      left=$(<$state/$unit.left)
      # `next` is a realtime timestamp in microseconds, even for --on-active.
      print -r -- "[{\"next\": $(( $(date +%s%6N) + left * 1000000 )), \"unit\": \"$unit\"}]"
    else
      print -r -- "[]"
    fi ;;
esac
exit 0
